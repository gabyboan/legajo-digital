!supabase/migrations/20260904143056_corregir_orden_validacion_cuit.sql
!supabase/migrations/20260904143446_corregir_tipo_posicion_cuit.sql

!supabase/migrations/20260907113237_modulo_validador_familiares.sql
/modules/validador-dni/__pycache__/

/modules/validador-familiares/__pycache__/

# Local background server logs and instance lock.
/.runtime/

# Local tooling, Python caches and imports with personnel data.
/.wrangler/
__pycache__/
*.py[cod]
/.venv/
/venv/
