{
  "name": "legajo-digital",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/test-repository.mjs && node scripts/test-validador.cjs && node scripts/test-consulta-nombre-familiar.cjs && node scripts/test-familiar-verificacion.cjs && node scripts/test-exportacion-personas.cjs && node scripts/test-persona-formulario.cjs && node scripts/test-mfa.cjs",
    "check:repo": "node scripts/check-repository.mjs",
    "audit:deps": "pnpm audit --audit-level=low",
    "check": "pnpm run check:repo && pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
