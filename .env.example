NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: hosts adicionales permitidos en desarrollo, separados por coma.
DEV_ALLOWED_ORIGINS=

# Validador de DNI local: solo lo lee el servidor Next.js; no usar NEXT_PUBLIC_.
# Estos valores usan el scraper incluido en este repositorio.
DNI_VALIDATOR_CWD=modules/validador-dni
DNI_VALIDATOR_SCRIPT=scraper.py
DNI_VALIDATOR_PYTHON=python

# Consulta por DNI en Datos de Familiares: scraper actualizado con Firefox.
DNI_FAMILIARES_CWD=modules/validador-familiares
