# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local cache
supabase/.temp/

# SQL files are local only, except DNI validation migrations.
*.sql
!supabase/migrations/20260901104621_add_familiar_fallecido.sql
!supabase/migrations/20260904124155_add_persona_dni_validaciones.sql
!supabase/migrations/20260904133603_fix_persona_dni_validacion_rpc.sql
